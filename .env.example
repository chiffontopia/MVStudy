DATABASE_URL=postgresql+psycopg://mvstudy:mvstudy@127.0.0.1:5433/mvstudy
TEST_DATABASE_URL=postgresql+psycopg://mvstudy:mvstudy@127.0.0.1:5433/mvstudy_test
JWT_SECRET=change-me-in-real-env-0123456789abcdef
JWT_TTL_MINUTES=480
# 相对路径按仓库根解析；文件字节不提交版本库（.gitignore 已忽略 var/）
FILE_STORAGE_DIR=./var/files
# 单文件字节上限；multipart 的边界与头部另留 64 KiB 传输余量
MAX_CONTENT_LENGTH=524288
WEB_ORIGIN=http://localhost:5173
